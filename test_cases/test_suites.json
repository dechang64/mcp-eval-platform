{
  "functional": [
    {
      "id": "FN-001",
      "name": "MCP Handshake Initialization",
      "description": "Verify the server completes the MCP protocol handshake correctly",
      "method": "initialize",
      "params": {"protocol_version": "2024-11-05"},
      "expected": {"protocol_version": "not_null", "capabilities": "exists", "server_info": "exists"},
      "timeout": 10
    },
    {
      "id": "FN-002",
      "name": "List Available Tools",
      "description": "Verify the server returns a correct tool list",
      "method": "tools/list",
      "params": {},
      "expected": {"tools": "array, non_empty"},
      "timeout": 10
    },
    {
      "id": "FN-003",
      "name": "Call Tool (Valid Arguments)",
      "description": "Call the first tool with empty arguments, verify response structure",
      "method": "tools/call",
      "params_template": {"name": "{first_tool}", "arguments": {}},
      "expected": {"content": "exists", "is_error": false},
      "timeout": 30
    },
    {
      "id": "FN-004",
      "name": "Call Nonexistent Tool",
      "description": "Verify that calling a nonexistent tool returns an error instead of crashing",
      "method": "tools/call",
      "params": {"name": "__nonexistent_tool__", "arguments": {}},
      "expected": {"is_error": true, "no_crash": true},
      "timeout": 10
    },
    {
      "id": "FN-005",
      "name": "Call Tool (Invalid Arguments)",
      "description": "Call a tool with a wrong argument name, verify error handling",
      "method": "tools/call",
      "params_template": {"name": "{first_tool}", "arguments": {"__invalid_param__": true}},
      "expected": {"is_error": true, "no_crash": true},
      "timeout": 10
    },
    {
      "id": "FN-006",
      "name": "List Resources (If Supported)",
      "description": "Try listing resources; mark as skipped if unsupported",
      "method": "resources/list",
      "params": {},
      "expected": {"resources": "array"},
      "optional": true,
      "timeout": 10
    },
    {
      "id": "FN-007",
      "name": "List Prompts (If Supported)",
      "description": "Try listing prompts; mark as skipped if unsupported",
      "method": "prompts/list",
      "params": {},
      "expected": {"prompts": "array"},
      "optional": true,
      "timeout": 10
    }
  ],
  "performance": [
    {
      "id": "PF-001",
      "name": "Tool Call Latency",
      "description": "Measure p50/p95/p99 latency of tool calls",
      "method": "tools/call",
      "params_template": {"name": "{first_tool}", "arguments": {}},
      "iterations": 20,
      "metrics": ["p50_ms", "p95_ms", "p99_ms", "mean_ms"],
      "timeout": 120
    },
    {
      "id": "PF-002",
      "name": "Concurrent Tool Calls",
      "description": "Throughput under different concurrency levels",
      "method": "tools/call",
      "params_template": {"name": "{first_tool}", "arguments": {}},
      "concurrency_levels": [1, 5, 10],
      "iterations_per_level": 10,
      "metrics": ["throughput_rps", "error_rate"],
      "timeout": 120
    },
    {
      "id": "PF-003",
      "name": "Sustained Call Stability",
      "description": "50 consecutive calls to detect memory leaks or performance degradation",
      "method": "tools/call",
      "params_template": {"name": "{first_tool}", "arguments": {}},
      "iterations": 50,
      "metrics": ["trend_slope", "max_vs_min_ratio"],
      "timeout": 120
    }
  ],
  "security": [
    {
      "id": "SEC-001",
      "name": "SQL Injection Arguments",
      "description": "Inject SQL into arguments, verify the server does not crash",
      "method": "tools/call",
      "params_template": {"name": "{first_tool}", "arguments": {"query": "'; DROP TABLE--"}},
      "expected": {"no_crash": true},
      "timeout": 10
    },
    {
      "id": "SEC-002",
      "name": "Path Traversal Arguments",
      "description": "Attempt path traversal via arguments",
      "method": "tools/call",
      "params_template": {"name": "{first_tool}", "arguments": {"path": "../../../etc/passwd"}},
      "expected": {"no_crash": true},
      "timeout": 10
    },
    {
      "id": "SEC-003",
      "name": "Oversized Arguments",
      "description": "Send a 10KB oversized string argument",
      "method": "tools/call",
      "params_template": {"name": "{first_tool}", "arguments": {"data": "{long_string_10k}"}},
      "expected": {"no_crash": true},
      "timeout": 10
    },
    {
      "id": "SEC-004",
      "name": "Special Characters Arguments",
      "description": "Send arguments containing null / control characters",
      "method": "tools/call",
      "params_template": {"name": "{first_tool}", "arguments": {"data": "{special_chars}"}},
      "expected": {"no_crash": true},
      "timeout": 10
    },
    {
      "id": "SEC-005",
      "name": "Timeout Tolerance",
      "description": "Send arguments that may trigger long processing, verify timeout handling",
      "method": "tools/call",
      "params_template": {"name": "{first_tool}", "arguments": {"query": "{nested_100x}"}},
      "expected": {"no_crash": true},
      "timeout": 15
    }
  ]
}
