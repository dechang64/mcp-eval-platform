# Template for Streamlit secrets. NEVER commit the real secrets.toml —
# it is covered by .gitignore. On Streamlit Cloud, paste these keys into
# the app's Settings -> Secrets panel instead. All values below are
# PLACEHOLDERS.

# Access gate for the whole app (app.py). Omit or leave empty to disable.
APP_PASSWORD = "choose-a-strong-password"

# AMAX (OpenAI-compatible) LLM backend — required for LLM Compatibility
# and Agent Loop pages.
AMAX_API_KEY = "paste-your-amax-api-key-here"
AMAX_BASE_URL = "https://ai.amaxsmp.com/v1"
AMAX_MODEL = "qwen3.5-flash-nothinking"

# Daily cap on LLM-backed evaluation runs (default 200).
LLM_DAILY_BUDGET_RUNS = "200"

# Cloud lock-down mode: hides server registration, presets the demo servers.
MCP_EVAL_CLOUD = "1"
